#!/usr/bin/env python3
"""Verify that this installed Brand Skill matches templates/build-manifest.json.

Generated by DesignBuddy. Standard library only. Read-only.
"""
import hashlib
import json
import sys
from pathlib import Path

try:
    sys.stdout.reconfigure(errors="replace")
except Exception:
    pass

root = Path(__file__).resolve().parent.parent
manifest_path = root / "templates" / "build-manifest.json"
print("=== BRAND SKILL SELFCHECK BEGIN ===")
try:
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
except Exception as e:
    print("- [FAIL] manifest unreadable: %s" % type(e).__name__)
    print("overall: MISMATCH")
    print("=== BRAND SKILL SELFCHECK END ===")
    sys.exit(1)
print("skill: %s %s | build_id: %s" % (manifest["skill"], manifest["skill_version"], manifest["build_id"]))
bad = 0
for rel, want in sorted(manifest["files"].items()):
    p = root / rel
    if not p.is_file():
        print("- [MISSING] %s" % rel)
        bad += 1
        continue
    data = p.read_bytes()
    if hashlib.sha256(data).hexdigest() == want:
        continue
    if hashlib.sha256(data.replace(b"\r\n", b"\n")).hexdigest() == want:
        print("- [MISMATCH-NEWLINE-ONLY] %s" % rel)
    else:
        print("- [MISMATCH] %s" % rel)
    bad += 1
# Files the WorkBuddy client adds at install time (OBSERVED: WorkBuddy 5.7.7.0 / Windows).
# Only the name is checked; the content is never read.
PLATFORM_META = {"_user_meta.json"}
expected = set(manifest["files"]) | {"templates/build-manifest.json"}
unknown = 0
for p in sorted(root.rglob("*")):
    if p.is_file() and "__pycache__" not in p.parts:
        rel = p.relative_to(root).as_posix()
        if rel in expected:
            continue
        if rel in PLATFORM_META:
            print("- [PLATFORM-META] %s" % rel)
        else:
            print("- [EXTRA] %s" % rel)
            unknown += 1
print("files_checked: %d" % len(manifest["files"]))
if bad:
    overall, code = "MISMATCH", 1
elif unknown:
    overall, code = "MATCH_WITH_EXTRA", 3
else:
    overall, code = "MATCH", 0
print("overall: %s" % overall)
print("=== BRAND SKILL SELFCHECK END ===")
sys.exit(code)
