#!/usr/bin/env python3
"""Static brand check for HTML / CSS / SVG text files.

Checks that every hex colour used is in the approved palette and that
font-family declarations use the brand fonts (or their CSS variables).
Generated by DesignBuddy. Standard library only.

Usage: python3 validate_brand.py <file> [<file> ...]
"""
import json
import re
import sys
from pathlib import Path

try:
    sys.stdout.reconfigure(errors="replace")
except Exception:
    pass

ROOT = Path(__file__).resolve().parent.parent
tokens = json.loads((ROOT / "templates" / "tokens" / "tokens.json").read_text(encoding="utf-8"))
palette = {v["$value"].upper() for v in tokens["color"].values()}
fonts = [tokens["font"][k]["$value"] for k in ("heading", "body")]
HEX = re.compile(r"#[0-9A-Fa-f]{6}\b|#[0-9A-Fa-f]{3}\b")


def expand(h):
    h = h.upper()
    return "#" + "".join(c * 2 for c in h[1:]) if len(h) == 4 else h


def check(path):
    text = Path(path).read_text(encoding="utf-8", errors="replace")
    issues = []
    for m in HEX.finditer(text):
        if expand(m.group(0)) not in palette:
            issues.append("NEVER-COLOR-01 未批准的颜色 %s" % m.group(0))
    for m in re.finditer(r"font-family\s*:\s*([^;}\"]+)", text):
        decl = m.group(1)
        if "var(--font-" not in decl and not any(f in decl for f in fonts):
            issues.append("MUST-TYPE 字体声明未使用品牌字体：%s" % decl.strip()[:60])
    return issues


def main(argv):
    if not argv:
        print(__doc__)
        return 2
    total = 0
    for f in argv:
        issues = check(f)
        total += len(issues)
        print("[%s] %s" % ("PASS" if not issues else "FAIL", f))
        for i in issues:
            print("    - %s" % i)
    return 1 if total else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
