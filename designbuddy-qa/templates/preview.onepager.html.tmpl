<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{brand_name}} · One-pager Preview</title>
<!-- generated by {{generated_by}} · build {{build_id}} · offline, no external resources -->
<style>
{{tokens_css}}
*{box-sizing:border-box;margin:0}
body{background:var(--color-paper);color:var(--color-ink);font-family:var(--font-body);font-size:var(--type-body);line-height:1.7}
header{background:var(--color-primary);color:var(--color-on-primary);padding:var(--space-12) var(--space-6)}
header .eyebrow{max-width:900px;margin:0 auto var(--space-2);font-size:var(--type-small);letter-spacing:.08em;font-weight:600}
header h1{font-family:var(--font-heading);font-weight:var(--heading-weight);font-size:var(--type-h1);line-height:1.2;max-width:900px;margin:0 auto}
header p{max-width:900px;margin:var(--space-3) auto 0}
section{max-width:900px;margin:0 auto;padding:var(--space-8) var(--space-6)}
h2{font-family:var(--font-heading);font-weight:var(--heading-weight);font-size:var(--type-h2);margin-bottom:var(--space-4);color:var(--color-ink)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:var(--space-4)}
.card{background:var(--color-surface);border-radius:var(--radius);padding:var(--space-4)}
.card b{display:block;color:var(--color-brand-text);margin-bottom:var(--space-1);font-size:var(--type-small);letter-spacing:.04em}
.swatches{display:flex;flex-wrap:wrap;gap:var(--space-2)}
.sw{width:120px;border-radius:var(--radius);overflow:hidden;font-size:var(--type-caption);background:var(--color-paper);box-shadow:var(--shadow-sm)}
.sw i{display:block;height:56px;box-shadow:inset 0 -1px 0 rgba(0,0,0,.08)}
.sw span{display:block;padding:var(--space-1) var(--space-2)}
a{color:var(--color-brand-text)}
footer{max-width:900px;margin:0 auto;padding:var(--space-6);font-size:var(--type-caption)}
</style>
</head>
<body>
<header>
  <div class="eyebrow">{{brand_name}}</div>
  <h1>{{headline}}</h1>
  <p>{{subline}}</p>
</header>
<section>
  <h2>品牌原则</h2>
  <div class="cards">
{{principle_cards}}
  </div>
</section>
<section>
  <h2>色板</h2>
  <div class="swatches">
{{swatches}}
  </div>
</section>
<footer>{{brand_name}} · Design System {{system_version}} · 本页为离线样例，用于验收设计系统，不是正式物料。</footer>
</body>
</html>
