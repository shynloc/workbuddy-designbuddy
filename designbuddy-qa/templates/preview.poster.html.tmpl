<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{brand_name}} · Poster Preview</title>
<!-- generated by {{generated_by}} · build {{build_id}} · offline, no external resources -->
<style>
{{tokens_css}}
*{box-sizing:border-box;margin:0}
body{background:var(--color-surface);font-family:var(--font-body);color:var(--color-ink);padding:var(--space-4)}
.poster{width:min(540px,100%);min-height:675px;margin:0 auto;background:var(--color-paper);border-radius:var(--radius);box-shadow:var(--shadow-md);display:flex;flex-direction:column;justify-content:space-between;gap:var(--space-4);padding:var(--space-8);padding-right:calc(28% + var(--space-6));position:relative;overflow:hidden}
.band{position:absolute;right:0;top:0;width:28%;height:100%;background:var(--color-primary)}
.eyebrow{font-size:var(--type-small);letter-spacing:.08em;color:var(--color-brand-text);font-weight:600;position:relative}
h1{font-family:var(--font-heading);font-weight:var(--heading-weight);font-size:var(--type-display);line-height:1.15;position:relative;overflow-wrap:anywhere}
.lead{font-family:var(--font-heading);font-size:var(--type-h3);line-height:1.4;margin-top:var(--space-3);position:relative}
p{font-size:var(--type-body);line-height:1.7;position:relative}
.cta{display:inline-block;background:var(--color-primary);color:var(--color-on-primary);padding:var(--space-2) var(--space-4);border-radius:var(--radius);font-weight:600;position:relative}
.meta{font-size:var(--type-caption);color:var(--color-ink);position:relative}
</style>
</head>
<body>
<main class="poster" aria-label="{{brand_name}} poster preview">
  <div class="band" aria-hidden="true"></div>
  <div class="eyebrow">{{brand_name}}</div>
  <div>
    <h1>{{headline}}</h1>
    <div class="lead">{{lead}}</div>
  </div>
  <p>{{subline}}</p>
  <div><span class="cta">{{cta}}</span></div>
  <div class="meta">Preview · Design System {{system_version}} · {{direction_name}}</div>
</main>
</body>
</html>
