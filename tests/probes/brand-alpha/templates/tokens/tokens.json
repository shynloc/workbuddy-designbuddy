{
  "$description": "Alpha Demo design tokens (W3C DTCG format). Fictional test brand.",
  "color": {
    "primary": {
      "$value": "#1F4FD8",
      "$type": "color",
      "$description": "Alpha Blue — 标题强调、按钮、图表主序列"
    },
    "ink": {
      "$value": "#111827",
      "$type": "color",
      "$description": "Ink — 正文文字"
    },
    "paper": {
      "$value": "#FFFFFF",
      "$type": "color",
      "$description": "Paper — 页面背景"
    },
    "mist": {
      "$value": "#EEF2FF",
      "$type": "color",
      "$description": "Mist — 卡片与分区背景"
    },
    "accent": {
      "$value": "#B45309",
      "$type": "color",
      "$description": "Signal Amber — 少量高亮、数据标注点；禁止用作文字色"
    }
  },
  "font": {
    "heading": {
      "$value": "Source Han Sans SC（思源黑体）",
      "$type": "fontFamily"
    },
    "body": {
      "$value": "Source Han Sans SC（思源黑体）",
      "$type": "fontFamily"
    }
  },
  "radius": {
    "base": {
      "$value": "8px",
      "$type": "dimension"
    }
  },
  "$extensions": {
    "dbprobe.contrastPairs": [
      {
        "name": "body text / page",
        "fg": "color.ink",
        "bg": "color.paper"
      },
      {
        "name": "primary text / page",
        "fg": "color.primary",
        "bg": "color.paper"
      },
      {
        "name": "page text / primary fill",
        "fg": "color.paper",
        "bg": "color.primary"
      },
      {
        "name": "body text / tint surface",
        "fg": "color.ink",
        "bg": "color.mist"
      },
      {
        "name": "accent / page (UI only)",
        "fg": "color.accent",
        "bg": "color.paper",
        "large": true
      }
    ]
  }
}
