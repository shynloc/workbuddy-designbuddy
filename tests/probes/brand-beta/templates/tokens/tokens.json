{
  "$description": "Beta Demo design tokens (W3C DTCG format). Fictional test brand.",
  "color": {
    "primary": {
      "$value": "#9A3412",
      "$type": "color",
      "$description": "Beta Rust — 标题、引言线、按钮"
    },
    "ink": {
      "$value": "#1C1917",
      "$type": "color",
      "$description": "Charcoal — 正文文字"
    },
    "paper": {
      "$value": "#FFF7ED",
      "$type": "color",
      "$description": "Cream — 页面背景"
    },
    "sand": {
      "$value": "#FED7AA",
      "$type": "color",
      "$description": "Sand — 装饰色块、分区背景"
    },
    "accent": {
      "$value": "#0F766E",
      "$type": "color",
      "$description": "Teal Note — 链接与少量点缀"
    }
  },
  "font": {
    "heading": {
      "$value": "Source Han Serif SC（思源宋体）",
      "$type": "fontFamily"
    },
    "body": {
      "$value": "Source Han Sans SC（思源黑体）",
      "$type": "fontFamily"
    }
  },
  "radius": {
    "base": {
      "$value": "2px",
      "$type": "dimension"
    }
  },
  "$extensions": {
    "dbprobe.contrastPairs": [
      {
        "name": "body text / page",
        "fg": "color.ink",
        "bg": "color.paper"
      },
      {
        "name": "primary text / page",
        "fg": "color.primary",
        "bg": "color.paper"
      },
      {
        "name": "page text / primary fill",
        "fg": "color.paper",
        "bg": "color.primary"
      },
      {
        "name": "body text / tint surface",
        "fg": "color.ink",
        "bg": "color.sand"
      },
      {
        "name": "accent / page (UI only)",
        "fg": "color.accent",
        "bg": "color.paper",
        "large": true
      }
    ]
  }
}
